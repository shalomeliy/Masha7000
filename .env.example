# Copy to .env.local and fill in. .env.local is gitignored.
# OAuth 2.0 Client ID (type: Web application) from Google Cloud Console.
VITE_GOOGLE_CLIENT_ID=

# Optional: error monitoring (Sentry, free tier). The DSN from sentry.io > Project > Settings > Client Keys.
# Set it in Vercel (Production). Without it nothing is sent. Locally it is ignored (only the built app reports).
# VITE_SENTRY_DSN=

# Server only (Vercel > Settings > Environment Variables, Production only). Never prefix with VITE_.
# Without all of these the app keeps its browser-only sign-in (one click an hour, own Drive).
# GOOGLE_CLIENT_SECRET=   OAuth client secret (same client as above)
# SESSION_KEY=            32 random bytes, base64 (encrypts cookies and the stored Google token)
# OWNER_EMAIL=            the manager whose Drive holds the data
# KV_REST_API_URL= / KV_REST_API_TOKEN=   added automatically by the Upstash Redis integration

# Optional, server only: "בקשת תכונות חדשות" in Settings emails through Resend (free tier).
# RESEND_API_KEY=         from resend.com > API Keys (account opened with the recipient's address)
# FEEDBACK_TO=            recipient; defaults to the app maker's address
# FEEDBACK_FROM=          sender; defaults to "Shali <onboarding@resend.dev>" (needs no domain)
