{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": { "api/assistant.ts": { "maxDuration": 60 } },
  "rewrites": [
    { "source": "/api/v1/:path*", "destination": "/api/v1?path=:path*" },
    { "source": "/api/auth/start", "destination": "/api/signin?fn=auth-start" },
    { "source": "/api/auth/callback", "destination": "/api/signin?fn=auth-callback" },
    { "source": "/api/token", "destination": "/api/signin?fn=token" },
    { "source": "/api/logout", "destination": "/api/signin?fn=logout" },
    { "source": "/api/mfa", "destination": "/api/signin?fn=mfa" },
    { "source": "/api/owner", "destination": "/api/manage?fn=owner" },
    { "source": "/api/feedback", "destination": "/api/manage?fn=feedback" },
    { "source": "/api/claude-log", "destination": "/api/manage?fn=claude-log" },
    { "source": "/api/join", "destination": "/api/forms?fn=join" },
    { "source": "/api/constraints", "destination": "/api/forms?fn=constraints" },
    { "source": "/api/access", "destination": "/api/forms?fn=access" },
    { "source": "/((?!api/|assets/|icons/|sw.js|manifest.webmanifest|privacy.html|terms.html|accessibility.html|delete-account.html|.well-known/).*)", "destination": "/index.html" }],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://accounts.google.com/gsi/client; style-src 'self' 'unsafe-inline' https://accounts.google.com/gsi/style; img-src 'self' data: blob: https://*.googleusercontent.com https://www.gstatic.com; font-src 'self' data:; connect-src 'self' https://www.googleapis.com https://oauth2.googleapis.com https://accounts.google.com https://*.ingest.sentry.io https://*.ingest.us.sentry.io https://*.ingest.de.sentry.io; frame-src https://accounts.google.com; worker-src 'self'; manifest-src 'self'; media-src 'self' blob: data:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
        },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "same-origin" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin-allow-popups" },
        { "key": "Cross-Origin-Resource-Policy", "value": "same-origin" },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), geolocation=(), payment=(), usb=(), serial=(), bluetooth=(), hid=(), midi=(), magnetometer=(), gyroscope=(), accelerometer=(), microphone=(self)"
        }
      ]
    },
    { "source": "/api/(.*)", "headers": [{ "key": "Cache-Control", "value": "no-store" }] },
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ]
}
